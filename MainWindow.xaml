<Window x:Class="OriginalTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OriginalTaskbar"
        Height="28"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#FF202020">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="時計を表示" IsCheckable="True" x:Name="ShowClockMenuItem" Tag="Clock" Click="ToggleVisibility_Click"/>
            <MenuItem Header="時計に秒を表示" IsCheckable="True" x:Name="ShowClockSecondsMenuItem" Tag="ClockSeconds" Click="ToggleVisibility_Click"/>
            <MenuItem Header="CPUを表示" IsCheckable="True" x:Name="ShowCpuMenuItem" Tag="Cpu" Click="ToggleVisibility_Click"/>
            <MenuItem Header="メモリを表示" IsCheckable="True" x:Name="ShowMemoryMenuItem" Tag="Memory" Click="ToggleVisibility_Click"/>
            <MenuItem Header="ネットワークを表示" IsCheckable="True" x:Name="ShowNetworkMenuItem" Tag="Network" Click="ToggleVisibility_Click"/>
            <MenuItem Header="バッテリーを表示" IsCheckable="True" x:Name="ShowBatteryMenuItem" Tag="Battery" Click="ToggleVisibility_Click"/>
            <MenuItem Header="仮想デスクトップ番号を表示" IsCheckable="True" x:Name="ShowDesktopLabelMenuItem" Tag="DesktopLabel" Click="ToggleVisibility_Click"/>
            <MenuItem Header="実行中アプリ一覧を表示" IsCheckable="True" x:Name="ShowRunningAppsMenuItem" Tag="RunningApps" Click="ToggleVisibility_Click"/>
            <Separator/>
            <MenuItem Header="終了（タスクバーを復元）" Click="ExitMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="12,0,0,0"
                    TextElement.FontFamily="BIZ UDPGothic">
            <TextBlock x:Name="ClockLabel" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock x:Name="BatterySeparator" Text="  |  " Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
            <StackPanel x:Name="BatteryGroup" Orientation="Horizontal">
                <TextBlock x:Name="BatteryIcon" Width="20" TextAlignment="Center" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryLabel" Width="45" Foreground="White" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="CpuSeparator" Text="  |  " Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
            <StackPanel x:Name="CpuGroup" Orientation="Horizontal">
                <TextBlock Text="🖥" Width="20" TextAlignment="Center" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="CpuLabel" Width="40" Foreground="White" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MemorySeparator" Text="  |  " Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
            <StackPanel x:Name="MemoryGroup" Orientation="Horizontal">
                <TextBlock Text="💾" Width="20" TextAlignment="Center" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="MemoryLabel" Width="40" Foreground="White" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="NetworkSeparator" Text="  |  " Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock x:Name="NetworkLabel" Width="250" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>

        <ItemsControl x:Name="RunningAppsList"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Margin="40,0,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="RunningApp_Click"
                            Tag="{Binding Handle}"
                            ToolTip="{Binding Title}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TrayIconList"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Margin="0,0,110,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="TrayIcon_Click"
                            Tag="{Binding}"
                            ToolTip="{Binding Name}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            Cursor="Hand">
                        <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="DesktopLabel"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Foreground="White"
                   FontSize="13"/>
    </Grid>
</Window>
